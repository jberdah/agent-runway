{
  "name": "agent-runway",
  "version": "0.1.0",
  "description": "How much runway is left before your coding agent hits its rate limits - from the terminal, from Claude Code, or as an MCP tool.",
  "type": "module",
  "license": "MIT",
  "author": "jberdah (https://github.com/jberdah)",
  "homepage": "https://github.com/jberdah/agent-runway#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jberdah/agent-runway.git"
  },
  "bugs": {
    "url": "https://github.com/jberdah/agent-runway/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "agent-runway": "src/cli.mjs",
    "agent-runway-mcp": "src/mcp.mjs"
  },
  "exports": {
    ".": "./src/core.mjs"
  },
  "files": [
    "src",
    "skills",
    ".claude-plugin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "start": "node src/cli.mjs",
    "mcp": "node src/mcp.mjs",
    "smoke": "node scripts/smoke-mcp.mjs"
  },
  "keywords": [
    "claude",
    "claude-code",
    "mcp",
    "usage",
    "rate-limit",
    "quota"
  ],
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  }
}
